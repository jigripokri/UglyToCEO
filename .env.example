# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# On Replit these same names live in the Secrets pane — keep them in sync.

# Required: the server imports server/db.ts at startup and throws without this.
# Use a Neon dev branch, not production, if you can.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Required for POST /api/transform (the main headshot flow).
GOOGLE_API_KEY_HH=

# Required only for the /lab model-comparison page.
OPENROUTER_API_KEY_U2C=

# Optional. Defaults to 5000.
PORT=5000
